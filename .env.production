# Arquivo de variáveis de ambiente para a PRODUÇÃO.
# Este arquivo SERÁ versionado pelo Git (conforme definido nas decisões do projeto)
# para que o professor possa clonar o repositório, compilar e testar a aplicação
# apontando para o banco de dados e Firebase reais (sem emuladores).
#
# OBS: No Firebase para Web/PWA (client-side), essas chaves são PÚBLICAS.
# A segurança dos dados é garantida pelas REGRAS do Firestore (firestore.rules),
# e não pelo ocultamento destas chaves.

VITE_USE_EMULATORS=false

# ⚠️ INSTRUÇÕES:
# 1. Crie um projeto real no Firebase Console.
# 2. Ative o "Authentication" (E-mail/Senha).
# 3. Ative o "Firestore Database" no modo Produção e faça deploy das regras (firebase deploy --only firestore:rules).
# 4. Adicione um App Web nas configurações do projeto e cole as chaves aqui embaixo.
# 5. Após preencher, rode `npm run build && firebase deploy` para subir para o Firebase Hosting.

VITE_FIREBASE_API_KEY="SUA_API_KEY_AQUI"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="00000000000"
VITE_FIREBASE_APP_ID="1:0000000000:web:xxxxx"
