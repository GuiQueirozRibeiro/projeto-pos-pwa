# =====================================================================
# Variáveis de ambiente do Ritmo
# =====================================================================
# Copie para ".env" (cp .env.example .env). O .env NÃO vai para o git.
#
# Só variáveis com prefixo VITE_ chegam ao código do navegador
# (import.meta.env.VITE_...). Por isso nada secreto deve ficar aqui:
# a config do Firebase Web é PÚBLICA por natureza, e quem protege os
# dados são as regras em firestore.rules.
# =====================================================================

# --- Config do app Web do Firebase -----------------------------------
# Console Firebase > Configurações do projeto > Seus apps > Config.
# Enquanto VITE_USE_EMULATORS=true, podem ficar vazias: o app usa o
# projeto "demo-ritmo", que só existe nos emuladores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Ambiente ---------------------------------------------------------
# true  = Auth (:9099) e Firestore (:8080) nos emuladores locais
#         (rode `npm run emulators` em outro terminal).
# false = projeto Firebase real configurado acima.
VITE_USE_EMULATORS=true

# --- Backend de dados (padrão do professor) ---------------------------
# "firestore" = dados no Firestore (emulador ou real).
# "mock"      = dublê em memória, útil para testar a UI sem Firebase.
VITE_DATA_BACKEND=firestore
