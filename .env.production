# Arquivo de variáveis de ambiente para a PRODUÇÃO.
# Este arquivo SERÁ versionado pelo Git (conforme definido nas decisões do projeto)
# para que o professor possa clonar o repositório, compilar e testar a aplicação
# apontando para o banco de dados e Firebase reais (sem emuladores).
#
# OBS: No Firebase para Web/PWA (client-side), essas chaves são PÚBLICAS.
# A segurança dos dados é garantida pelas REGRAS do Firestore (firestore.rules),
# e não pelo ocultamento destas chaves.

VITE_USE_EMULATORS=false

# ⚠️ INSTRUÇÕES PARA AVALIAÇÃO:
# O app já está configurado para o projeto real abaixo.
# Para testar localmente contra a nuvem, basta rodar:
# npm run build && npm run preview

VITE_FIREBASE_API_KEY="AIzaSyBeZ7xwBG_TO2MlL8S_CDtvwhK38dDsVjQ"
VITE_FIREBASE_AUTH_DOMAIN="projeto-pos-pwa.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="projeto-pos-pwa"
VITE_FIREBASE_STORAGE_BUCKET="projeto-pos-pwa.firebasestorage.app"
